// ---------------------------------------------------------------
// 5x7 stencil pixel font for the word clock face
// "1" = void (light shines through), "0" = plate material.
// Letters with enclosed counters (A B D O P Q R) carry a stencil
// bridge so no island of face material floats unanchored on the
// bed when the plate prints letters-down.
// ---------------------------------------------------------------

FONT = [
["A",["01110","10001","10001","11011","10001","10001","10001"]],
["B",["11110","10001","10001","11010","10001","10001","11010"]],
["C",["01110","10001","10000","10000","10000","10001","01110"]],
["D",["11110","10001","10001","00001","10001","10001","11110"]],
["E",["11111","10000","10000","11110","10000","10000","11111"]],
["F",["11111","10000","10000","11110","10000","10000","10000"]],
["G",["01110","10001","10000","10011","10001","10001","01110"]],
["H",["10001","10001","10001","11111","10001","10001","10001"]],
["I",["11111","00100","00100","00100","00100","00100","11111"]],
["J",["00111","00010","00010","00010","00010","10010","01100"]],
["K",["10001","10010","10100","11000","10100","10010","10001"]],
["L",["10000","10000","10000","10000","10000","10000","11111"]],
["M",["10001","11011","10101","10101","10001","10001","10001"]],
["N",["10001","11001","10101","10011","10001","10001","10001"]],
["O",["01110","10001","10001","00001","10001","10001","01110"]],
["P",["11110","10001","00001","11110","10000","10000","10000"]],
["Q",["01110","10001","10001","00001","10101","10010","01101"]],
["R",["11110","10001","00001","11110","10100","10010","10001"]],
["S",["01111","10000","10000","01110","00001","00001","11110"]],
["T",["11111","00100","00100","00100","00100","00100","00100"]],
["U",["10001","10001","10001","10001","10001","10001","01110"]],
["V",["10001","10001","10001","10001","01010","01010","00100"]],
["W",["10001","10001","10001","10101","10101","11011","10001"]],
["X",["10001","10001","01010","00100","01010","10001","10001"]],
["Y",["10001","10001","01010","00100","00100","00100","00100"]],
["Z",["11111","00001","00010","00100","01000","10000","11111"]]
];

function glyph_row(ch, r) =
    let (hit = search([ch], FONT))
    (hit == [] || hit[0] == []) ? undef : FONT[hit[0]][1][r];

// One letter, centred on the origin. px = pixel size; bleed
// slightly oversizes each pixel so diagonal strokes (V X Z K...)
// overlap instead of touching corner-to-corner (manifold safety).
module glyph2d(ch, px = 1.1, bleed = 0.12) {
    if (ch != " " && glyph_row(ch, 0) != undef)
        for (r = [0:6], c = [0:4])
            if (glyph_row(ch, r)[c] == "1")
                translate([(c - 2) * px, (3 - r) * px])
                    square(px + bleed, center = true);
}
